# Backend API URL
# For local development: http://localhost:3001/api
# For production (Render): https://mrguide-backend.onrender.com/api
REACT_APP_API_URL=http://localhost:3001/api

# Google Maps API Key (used by every map screen via @react-google-maps/api)
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Stripe publishable key (pk_test_... or pk_live_...) for card payments on /pay/:tripId.
# Without it the payment page shows a notice instead of the card form.
REACT_APP_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
