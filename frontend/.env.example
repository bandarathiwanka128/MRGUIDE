# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/
# Enable the following APIs:
# - Maps JavaScript API
# - Places API
# - Directions API
# - Geocoding API
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend API URL
REACT_APP_API_URL=http://localhost:3001/api
